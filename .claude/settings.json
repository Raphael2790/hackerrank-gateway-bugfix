{
  "permissions": {
    "deny": [
      "Read(/hidden_tests/**)",
      "Read(/.gabarito/**)",
      "Read(**/*.b64)",
      "Read(~/.claude/plans/**)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude/file-history/**)",
      "Read(~/AppData/Local/Temp/claude/**)",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git grep *)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/trava_treino.py"]
          }
        ]
      }
    ]
  }
}
