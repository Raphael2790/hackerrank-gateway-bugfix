{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PayFlow: API (Flask)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["--app", "app", "run", "--debug", "--port", "5000"],
      "env": {
        "FLASK_APP": "app",
        "FLASK_DEBUG": "1"
      },
      "jinja": false,
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "PayFlow: testes visíveis",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-vv"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "PayFlow: meus_testes",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["meus_testes", "-vv", "-x"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "PayFlow: arquivo de teste aberto",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-vv"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
